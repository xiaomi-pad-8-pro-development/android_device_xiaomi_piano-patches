From 76b83d87f953fe76680f729a018101c31417d979 Mon Sep 17 00:00:00 2001
From: MUHAMMAD ALIF DANIEL BIN MOHD HAIRUL HEZZELIN
 <alifdaniel.personalspace@gmail.com>
Date: Wed, 18 Nov 2026 05:52:14 +0000
Subject: [PATCH] Settings: Support side fingerprint sensors on portrait
 tablets

The find sensor animations assume the stock device layout. On a natively
portrait tablet with the power key at the left end of the top edge in
landscape, they show a portrait device with the key on its left edge.

Add config_sfpsOnPortraitTabletTopEdge. When set, pick a stock drawing
of the right shape for each rotation and mirror it so the key sits at the
top left in landscape and the top right in portrait.
---
 res/values/config.xml                         |  4 ++++
 .../FingerprintEnrollFindSensor.java          | 21 +++++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/res/values/config.xml b/res/values/config.xml
index 0399a2f..129eccc 100644
--- a/res/values/config.xml
+++ b/res/values/config.xml
@@ -1097,4 +1097,8 @@
 
     <!-- TODO(b/496286136): Whether to force showing the icon on the locale picker screen. -->
     <bool name="config_force_showing_icon_on_locale_picker_screen">false</bool>
+    <!-- Natively portrait tablet whose side fingerprint sensor is at the
+         left end of the top edge in landscape. Mirrors the stock find sensor
+         animations to match. -->
+    <bool name="config_sfpsOnPortraitTabletTopEdge">false</bool>
 </resources>
diff --git a/src/com/android/settings/biometrics/fingerprint/FingerprintEnrollFindSensor.java b/src/com/android/settings/biometrics/fingerprint/FingerprintEnrollFindSensor.java
index 71a811f..c8e5923 100644
--- a/src/com/android/settings/biometrics/fingerprint/FingerprintEnrollFindSensor.java
+++ b/src/com/android/settings/biometrics/fingerprint/FingerprintEnrollFindSensor.java
@@ -237,6 +237,27 @@ public class FingerprintEnrollFindSensor extends BiometricEnrollBase implements
         final int rotation = getRotationFromDefault(
                 getApplicationContext().getDisplay().getRotation());
 
+        if (getResources().getBoolean(R.bool.config_sfpsOnPortraitTabletTopEdge)) {
+            // Natively portrait tablet with the power key at the left end of
+            // the top edge in landscape (the right edge, near the top, in
+            // portrait). Mirror the stock drawings to put the key there.
+            final int raw = getApplicationContext().getDisplay().getRotation();
+            final int[] assets = {
+                    R.raw.fingerprint_edu_lottie_portrait_top_left,
+                    R.raw.fingerprint_edu_lottie_landscape_bottom_left,
+                    R.raw.fingerprint_edu_lottie_portrait_bottom_right,
+                    R.raw.fingerprint_edu_lottie_landscape_top_right,
+            };
+            final boolean portrait = raw % 2 == 0;
+            mIllustrationLottie.setAnimation(assets[raw]);
+            mIllustrationLottie.setScaleX(portrait ? -1f : 1f);
+            mIllustrationLottie.setScaleY(portrait ? 1f : -1f);
+            LottieColorUtils.applyDynamicColors(getApplicationContext(), mIllustrationLottie);
+            mIllustrationLottie.setVisibility(View.VISIBLE);
+            mIllustrationLottie.playAnimation();
+            return;
+        }
+
         switch (rotation) {
             case Surface.ROTATION_90:
                 if (mIsFolded) {
-- 
