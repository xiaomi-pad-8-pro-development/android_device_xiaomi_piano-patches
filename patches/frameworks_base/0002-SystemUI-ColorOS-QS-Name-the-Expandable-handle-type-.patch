From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MUHAMMAD ALIF DANIEL BIN MOHD HAIRUL HEZZELIN
 <alifdaniel.personalspace@gmail.com>
Date: Sun, 1 Nov 2026 02:56:19 +0800
Subject: [PATCH] SystemUI: ColorOS QS: Name the Expandable handle type in full

The file imports the Compose Expandable function, so the bare name does
not resolve to the com.android.systemui.animation.Expandable type.
---
 .../systemui/qs/composefragment/ColorOSQuickSettings.kt     | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

 M core/java/android/widget/OverScroller.java
 M packages/SystemUI/src/com/android/systemui/shade/ShadeExpansionStateManager.kt
 M services/core/java/com/android/server/input/InputManagerService.java
diff --git a/packages/SystemUI/src/com/android/systemui/qs/composefragment/ColorOSQuickSettings.kt b/packages/SystemUI/src/com/android/systemui/qs/composefragment/ColorOSQuickSettings.kt
index ba557127d24c..3afd90188019 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/composefragment/ColorOSQuickSettings.kt
+++ b/packages/SystemUI/src/com/android/systemui/qs/composefragment/ColorOSQuickSettings.kt
@@ -935,8 +935,8 @@ private val ColorOSHeaderSettingsIconSize = 29.dp
  */
 @Composable
 internal fun ColorOSHeaderButtons(
-    onEdit: (Expandable) -> Unit,
-    onSettings: ((Expandable) -> Unit)?,
+    onEdit: (com.android.systemui.animation.Expandable) -> Unit,
+    onSettings: ((com.android.systemui.animation.Expandable) -> Unit)?,
     modifier: Modifier = Modifier,
 ) {
     val glass = colorOSGlass(blurred = LocalColorOSGlassBlur.current != null)
@@ -984,7 +984,7 @@ private fun ColorOSHeaderButton(
     iconSize: Dp,
     description: String,
     glass: ColorOSGlass,
-    onClick: (Expandable) -> Unit,
+    onClick: (com.android.systemui.animation.Expandable) -> Unit,
 ) {
     val pressSource = remember { MutableInteractionSource() }
     Expandable(
