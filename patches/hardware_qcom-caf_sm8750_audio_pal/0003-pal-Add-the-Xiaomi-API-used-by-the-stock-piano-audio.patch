     return 0;
 }
 
+int ResourceManager::muteActiveRxStream(bool state)
+{
+    int status = 0;
+    struct pal_stream_attributes sAttr;
+
+    activeRxMuted = state;
+    if (mActiveStreams.empty())
+        return -EINVAL;
+
+    mActiveStreamMutex.lock();
+    for (auto s : mActiveStreams) {
+        status = s->getStreamAttributes(&sAttr);
+        if (status != 0) {
+            PAL_ERR(LOG_TAG, "getStreamAttributes failed %d", status);
+            continue;
+        }
+        if (sAttr.direction != PAL_AUDIO_OUTPUT)
+            continue;
+        PAL_INFO(LOG_TAG, "%s stream type %d", state ? "mute" : "unmute", sAttr.type);
+        status = s->mute(state);
+    }
+    mActiveStreamMutex.unlock();
+
+    return status;
+}
+
 void ResourceManager::checkAndSetDutyCycleParam()
 {
     pal_stream_attributes StrAttr;
