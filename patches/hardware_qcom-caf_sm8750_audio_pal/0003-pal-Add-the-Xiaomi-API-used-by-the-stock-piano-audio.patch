From 284dafde5a855893332ecc2a31cf92491a08b049 Mon Sep 17 00:00:00 2001
From: MUHAMMAD ALIF DANIEL BIN MOHD HAIRUL HEZZELIN
 <alifdaniel.personalspace@gmail.com>
Date: Wed, 28 Oct 2026 14:04:22 +0800
Subject: [PATCH] pal: Add the Xiaomi API used by the stock piano audio HAL

The stock libaudiocorehal.qti imports pal_set_zoom_state,
pal_mute_active_rx, pal_get_mixctrl_name and setPalLogLevel, and fails
to load without them. Implement them the way the stock libar-pal does:

- pal_set_zoom_state marks a stream as recording with camera zoom;
  its record MFC then outputs three channels.
- pal_mute_active_rx mutes or unmutes every playback stream, and
  playback streams started while muted start muted.
- pal_get_mixctrl_name returns the stream's PCM or COMPRESS mixer
  control prefix ("PCM<id>", "COMPRESS<id>").
- setPalLogLevel maps the HAL log level onto pal_log_lvl.
---
 Pal.cpp                                  | 84 ++++++++++++++++++++++++
 inc/PalApi.h                             | 11 ++++
 resource_manager/inc/ResourceManager.h   |  2 +
 resource_manager/src/ResourceManager.cpp | 26 ++++++++
 session/inc/Session.h                    |  1 +
 session/inc/SessionAlsaCompress.h        |  1 +
 session/inc/SessionAlsaPcm.h             |  1 +
 session/src/SessionAlsaCompress.cpp      |  7 ++
 session/src/SessionAlsaPcm.cpp           |  9 +++
 stream/inc/Stream.h                      |  1 +
 stream/src/StreamPCM.cpp                 |  4 ++
 11 files changed, 147 insertions(+)

diff --git a/Pal.cpp b/Pal.cpp
index c30f729..b281d81 100644
--- a/Pal.cpp
+++ b/Pal.cpp
@@ -45,6 +45,7 @@
 #include <mutex>
 #include <PalApi.h>
 #include "Stream.h"
+#include "Session.h"
 #include "Device.h"
 #include "ResourceManager.h"
 #include "PalCommon.h"
@@ -1650,3 +1651,86 @@ int32_t pal_set_mic_mute(bool state){
     PAL_ERR(LOG_TAG, "error: API: pal_set_mic_mute not implemented");
     return -ENOSYS;
 }
+
+int32_t pal_set_zoom_state(pal_stream_handle_t *stream_handle, bool state)
+{
+    Stream *s = NULL;
+    int status;
+    std::shared_ptr<ResourceManager> rm = NULL;
+
+    rm = ResourceManager::getInstance();
+    if (!rm) {
+        PAL_ERR(LOG_TAG, "Invalid resource manager");
+        return -EINVAL;
+    }
+
+    rm->lockActiveStream();
+    if (!rm->isActiveStream(stream_handle)) {
+        rm->unlockActiveStream();
+        return -EINVAL;
+    }
+
+    s = reinterpret_cast<Stream *>(stream_handle);
+    status = rm->increaseStreamUserCounter(s);
+    rm->unlockActiveStream();
+    if (0 != status) {
+        PAL_ERR(LOG_TAG, "failed to increase stream user count");
+        return status;
+    }
+
+    s->isOnCamZoom = state;
+    PAL_DBG(LOG_TAG, "is_on_cam_zoom = %d", state);
+
+    rm->lockActiveStream();
+    rm->decreaseStreamUserCounter(s);
+    rm->unlockActiveStream();
+    return 0;
+}
+
+int32_t pal_mute_active_rx(bool state)
+{
+    std::shared_ptr<ResourceManager> rm = NULL;
+
+    rm = ResourceManager::getInstance();
+    if (!rm) {
+        PAL_ERR(LOG_TAG, "Invalid resource manager");
+        return -EINVAL;
+    }
+    return rm->muteActiveRxStream(state);
+}
+
+void setPalLogLevel(int level)
+{
+    switch (level) {
+    case 1:
+        pal_log_lvl = PAL_LOG_ERR | PAL_LOG_INFO;
+        break;
+    case 2:
+        pal_log_lvl = PAL_LOG_ERR | PAL_LOG_INFO | PAL_LOG_DBG;
+        break;
+    case 4:
+    case 8:
+        pal_log_lvl = PAL_LOG_ERR | PAL_LOG_INFO | PAL_LOG_DBG | PAL_LOG_VERBOSE;
+        break;
+    default:
+        PAL_INFO(LOG_TAG, "invalid log level %d", level);
+        break;
+    }
+}
+
+/* The caller frees the name with delete[]. */
+char *pal_get_mixctrl_name(pal_stream_handle_t *stream_handle)
+{
+    Stream *s = reinterpret_cast<Stream *>(stream_handle);
+    Session *session = NULL;
+    std::string name;
+    char *ret;
+
+    if (!s)
+        return nullptr;
+    if (!s->getAssociatedSession(&session) && session)
+        name = session->getMixctrlName();
+    ret = new char[name.size() + 1];
+    strlcpy(ret, name.c_str(), name.size() + 1);
+    return ret;
+}
diff --git a/inc/PalApi.h b/inc/PalApi.h
index 737cc3c..f0b1dd3 100644
--- a/inc/PalApi.h
+++ b/inc/PalApi.h
@@ -592,6 +592,17 @@ int32_t pal_gef_rw_param_acdb(uint32_t param_id, void *param_payload,
   */
 int32_t pal_register_for_events(pal_audio_event_callback cb_event);
 
+/*
+ * Xiaomi extensions called by the stock piano audio HAL: camera zoom
+ * recording, muting playback around device switches, and the stream's
+ * mixer control prefix. pal_get_mixctrl_name's result is freed with delete[].
+ */
+int32_t pal_set_zoom_state(pal_stream_handle_t *stream_handle, bool state);
+int32_t pal_mute_active_rx(bool state);
+char *pal_get_mixctrl_name(pal_stream_handle_t *stream_handle);
+/* Log level from the HAL: 1 error+info, 2 +debug, 4 or 8 +verbose. */
+void setPalLogLevel(int level);
+
 #ifdef __cplusplus
 }  /* extern "C" */
 #endif
