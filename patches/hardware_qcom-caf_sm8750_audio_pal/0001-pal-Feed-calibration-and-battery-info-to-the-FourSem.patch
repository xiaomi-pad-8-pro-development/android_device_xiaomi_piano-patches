+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ */
+
+#ifndef FOURSEMI_MONITOR_H
+#define FOURSEMI_MONITOR_H
+
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+
+/*
+ * Feeds the FourSemi speaker protection module in the DSP: the factory
+ * speaker calibration (RE25) once, then the battery voltage and temperature,
+ * which it uses to limit speaker power on a low or hot battery ("BSG"). The
+ * DSP module tells us what to report and how often.
+ */
+class FourSemiMonitor {
+public:
+    static FourSemiMonitor& getInstance();
+    static bool isFourSemiAmp();
+
+    void start();
+    void stop();
+
+private:
+    FourSemiMonitor() = default;
+    ~FourSemiMonitor();
+
+    /* Reporting config read from the DSP module, eight LE32 words. */
+    struct BsgConfig {
+        uint32_t vmode;      /* 1: voltage in uV, 2: capacity in % */
+        uint32_t ven;
+        uint32_t vinterval;  /* ms */
+        uint32_t vstep;
+        uint32_t tmode;
+        uint32_t ten;
+        uint32_t tinterval;  /* ms */
+        uint32_t tstep;      /* degrees C */
+    };
+
+    /* Battery info sent to the DSP module, four LE32 words. */
+    struct BsgInfo {
+        uint32_t vmode;
+        int32_t voltage;
+        uint32_t tmode;
+        int32_t temp;        /* tenths of a degree C */
+    };
+
+    void threadLoop();
+    bool sendCalibration();
+    bool queryConfig();
+    void report(bool force);
+    int intervalMs() const;
+
+    static int transfer(uint32_t paramId, void *data, uint32_t size, bool get);
+    static bool readSysfsInt(const char *path, int32_t *value);
+
+    std::mutex mLock;
+    std::condition_variable mCond;
+    std::thread mThread;
+    bool mRunning = false;
+    bool mExit = false;
+    bool mDisabled = false;
+    bool mCalibrated = false;
+    int mQueryFailures = 0;
+    BsgConfig mConfig = {};
+    int32_t mLastVoltage = 0;
+    int32_t mLastTemp = 0;
+};
+
+#endif /* FOURSEMI_MONITOR_H */
