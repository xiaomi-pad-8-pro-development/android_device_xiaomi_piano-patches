     constructor(context: Context?) : super(context) {}
     constructor(context: Context?, attributeSet: AttributeSet?) : super(context, attributeSet) {}
@@ -28,6 +29,25 @@ class CircleSurfaceView : SurfaceView {
     ) {
     }
 
+    fun setAspectRatio(width: Int, height: Int) {
+        mAspectRatio = width.toFloat() / height
+        requestLayout()
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        super.onMeasure(widthMeasureSpec, heightMeasureSpec)
+        if (mAspectRatio <= 0.0f) return
+        // Fit the preview inside the given bounds without stretching it.
+        var width = measuredWidth
+        var height = measuredHeight
+        if (width > height * mAspectRatio) {
+            width = (height * mAspectRatio).toInt()
+        } else {
+            height = (width / mAspectRatio).toInt()
+        }
+        setMeasuredDimension(width, height)
+    }
+
